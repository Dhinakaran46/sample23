pipeline{
    agent:any
    stages{
        stage('pull code'){
            steps{
                echo 'pulling code from git hub'
                checkout scm
            }
        }
        stage('Build Docker image'){
            step{
                echo 'Building the image'
            }
        }
        stage('push to docker hub'){
            step{
                echo 'pushing Docker image to docker hub'
            }
        }

    }
}